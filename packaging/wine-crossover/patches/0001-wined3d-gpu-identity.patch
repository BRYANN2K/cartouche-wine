+        if (!get_config_key(hkey, appkey, env, "VideoDriverVersion", buffer, size))
+        {
+            unsigned int v[4];
+            char end;
+
+            /* The four words of the Windows version, e.g. 32.0.15.8157 for NVIDIA 581.57. */
+            if (sscanf(buffer, "%u.%u.%u.%u%c", &v[0], &v[1], &v[2], &v[3], &end) == 4
+                    && v[0] <= 0xffff && v[1] <= 0xffff && v[2] <= 0xffff && v[3] <= 0xffff
+                    && (v[0] | v[1] | v[2] | v[3]))
+            {
+                TRACE("Using driver version %u.%u.%u.%u\n", v[0], v[1], v[2], v[3]);
+                wined3d_settings.driver_version_high = MAKEDWORD_VERSION(v[0], v[1]);
+                wined3d_settings.driver_version_low = MAKEDWORD_VERSION(v[2], v[3]);
+            }
+            else
+            {
+                ERR("Invalid value for VideoDriverVersion. The value should be four numbers up to 65535, like 32.0.15.8157\n");
+            }
+        }
