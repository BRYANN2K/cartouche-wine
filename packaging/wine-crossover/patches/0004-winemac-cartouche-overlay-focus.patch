From: Cartouche Wine
Subject: [PATCH] winemac.drv: The game keeps its focus while Cartouche's
 in-game menu is open.

Applies to sources/wine of crossover-sources-26.3.0.tar.gz (SHA-256
ac99c8ca4b3848f3e81784135f023df266b61c2345726ea55a50b3e030dd6872, Wine 11.0).

Cartouche's in-game menu is a panel that activates Cartouche, the only way to
free a cursor the game captured. A fullscreen game sees that as the user
switching away and minimizes itself.

Cartouche posts two distributed notifications, with the game's pid as the
object: dev.bryann2k.cartouche.overlay.willOpen and .didClose. On willOpen the
driver does what it already does for a macOS permission dialog: it ignores the
resign, and stops clipping the cursor. On didClose the game activates itself
(macOS accepts self-activation where it refuses Cartouche's request, or hands
the front to another app as Cartouche hides), once more 250 ms later, and
700 ms later it clips the cursor again and passes on a real focus loss.

Measured with a fullscreen probe that minimizes on WM_ACTIVATEAPP(FALSE), like
Unity games: 20 menu cycles, 0 minimizes; another app took the front 6 times
and the game had it back within 100 ms each time.

---
--- a/dlls/winemac.drv/cocoa_app.m
+++ b/dlls/winemac.drv/cocoa_app.m
@@ -16,6 +16,8 @@
  * You should have received a copy of the GNU Lesser General Public
  * License along with this library; if not, write to the Free Software
  * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ *
+ * Modified by Cartouche Wine on 2026-11-04: the game keeps its focus while Cartouche's in-game menu is open.
  */
 
 #import "cocoa_app.h"
@@ -30,6 +32,11 @@
 static NSString* const WineAppWaitQueryResponseMode = @"WineAppWaitQueryResponseMode";
 static NSString* const WineWillShowPermissionDialogNotification = @"WineWillShowPermissionDialogNotification";
 static NSString* const WineDidShowPermissionDialogNotification = @"WineDidShowPermissionDialogNotification";
+static NSString* const CartoucheOverlayWillOpenNotification = @"dev.bryann2k.cartouche.overlay.willOpen";
+static NSString* const CartoucheOverlayDidCloseNotification = @"dev.bryann2k.cartouche.overlay.didClose";
+static BOOL cartoucheClipRestore;
+static CGRect cartoucheClipRect;
+static NSUInteger cartoucheGeneration;
 
 // Private notifications that are reliably dispatched when a window is moved by dragging its titlebar.
 // The object of the notification is the window being dragged.
@@ -2112,6 +2119,57 @@ - (void) setupObservations
             temporarilyIgnoreResignEventsForDialog = FALSE;
         }];
 
+        /* Cartouche: its in-game menu takes the focus for a moment. Like a permission dialog,
+         * the game must not see it as a switch away, or a fullscreen game minimizes itself.
+         * The cursor is set free while the menu is open and clipped again after. */
+        [dnc addObserverForName:CartoucheOverlayWillOpenNotification
+                         object:[NSString stringWithFormat:@"%d", getpid()]
+                          queue:[NSOperationQueue mainQueue]
+                     usingBlock:^(NSNotification *note){
+            ++cartoucheGeneration;
+            NSLog(@"cartouche overlay: willOpen active=%d ignoring=%d clipping=%d", [NSApp isActive], temporarilyIgnoreResignEventsForDialog, self.clippingCursor);
+            if (![NSApp isActive] || temporarilyIgnoreResignEventsForDialog) return;
+            cartoucheClipRestore = self.clippingCursor;
+            if (cartoucheClipRestore)
+            {
+                cartoucheClipRect = clipCursorHandler.cursorClipRect;
+                [self stopClippingCursor];
+            }
+            [nc postNotificationName:WineWillShowPermissionDialogNotification object:nil];
+        }];
+
+        [dnc addObserverForName:CartoucheOverlayDidCloseNotification
+                         object:[NSString stringWithFormat:@"%d", getpid()]
+                          queue:[NSOperationQueue mainQueue]
+                     usingBlock:^(NSNotification *note){
+            NSUInteger generation = ++cartoucheGeneration;
+            NSLog(@"cartouche overlay: didClose active=%d ignoring=%d", [NSApp isActive], temporarilyIgnoreResignEventsForDialog);
+            if (!temporarilyIgnoreResignEventsForDialog) return;
+            /* The menu gives the focus back to the game. macOS may refuse Cartouche's request or
+             * hand the front to another app as Cartouche hides; the game takes it back itself */
+            if (![NSApp isActive])
+                [[NSRunningApplication currentApplication] activateWithOptions:NSApplicationActivateIgnoringOtherApps];
+            /* The menu's windows leave and focus settles for a moment after the close: a resign
+             * in that time is still the menu's, not the user switching away */
+            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 250 * NSEC_PER_MSEC), dispatch_get_main_queue(), ^{
+                if (generation != cartoucheGeneration || !temporarilyIgnoreResignEventsForDialog) return;
+                NSLog(@"cartouche overlay: reclaim active=%d", [NSApp isActive]);
+                if (![NSApp isActive])
+                    [[NSRunningApplication currentApplication] activateWithOptions:NSApplicationActivateIgnoringOtherApps];
+            });
+            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 700 * NSEC_PER_MSEC), dispatch_get_main_queue(), ^{
+                if (generation != cartoucheGeneration || !temporarilyIgnoreResignEventsForDialog) return;
+                NSLog(@"cartouche overlay: settled active=%d", [NSApp isActive]);
+                [nc postNotificationName:WineDidShowPermissionDialogNotification object:nil];
+                if (cartoucheClipRestore)
+                {
+                    cartoucheClipRestore = FALSE;
+                    [self startClippingCursor:cartoucheClipRect];
+                }
+                if (![NSApp isActive]) [self applicationDidResignActive:nil];
+            });
+        }];
+
         if ([NSApplication instancesRespondToSelector:@selector(yieldActivationToApplication:)])
         {
             /* App activation cooperation, starting in macOS 14 Sonoma. */
@@ -2486,6 +2544,7 @@ - (void)applicationDidResignActive:(NSNotification *)notification
 
         [self invalidateGotFocusEvents];
 
+        NSLog(@"cartouche overlay: resign active, ignoring=%d", temporarilyIgnoreResignEventsForDialog);
         if (!temporarilyIgnoreResignEventsForDialog)
         {
             event = macdrv_create_event(APP_DEACTIVATED, nil);
