# Everything the Cartouche Wine build is pinned to. Sourced by the scripts in this
# folder and by .github/workflows/wine-crossover.yml. A new CodeWeavers tarball
# means a new CX_VERSION, its SHA-256 and BUILD_REVISION back to 1.

# CodeWeavers' LGPL sources, https://www.codeweavers.com/crossover/source
# Checked 2026-10-19: 149054023 bytes, Last-Modified 2026-07-21, Wine 11.0 inside.
CX_VERSION=26.3.0
CX_SOURCE_URL=https://media.codeweavers.com/pub/crossover/source/crossover-sources-26.3.0.tar.gz
CX_SOURCE_SHA256=ac99c8ca4b3848f3e81784135f023df266b61c2345726ea55a50b3e030dd6872
CX_SOURCE_SIZE=149054023

# Bumped when the same sources are built again with a changed script or toolchain
BUILD_REVISION=2

# MinGW cross compiler for the PE side, https://github.com/mstorsjo/llvm-mingw
LLVM_MINGW_VERSION=20261006
LLVM_MINGW_URL=https://github.com/mstorsjo/llvm-mingw/releases/download/20261006/llvm-mingw-20261006-ucrt-macos-universal.tar.xz
LLVM_MINGW_SHA256=a7a19b11048e89372637d26279cdb7c430ed3cf8c1e224310421312bf986ebf6

# The x86_64 runner image and its Xcode (actions/runner-images, macOS 15 x64)
XCODE_APP=/Applications/Xcode_16.4.app
MACOSX_DEPLOYMENT_TARGET=15.0

# Homebrew formulas the build links against. Their dylibs are copied into the
# package, so a user's Mac needs none of them.
BREW_BUILD_DEPS="bison flex pkgconf"
# Homebrew sdl2 is sdl2-compat: SDL3 is loaded with dlopen, not an LC_LOAD_DYLIB.
BREW_LINK_DEPS="freetype gnutls molten-vk sdl2 sdl3"

# Wine Mono and Wine Gecko at the versions Wine 11.0 asks for (MONO_VERSION and
# GECKO_VERSION in sources/wine/dlls/appwiz.cpl/addons.c; build.sh checks).
# Unpacked into share/wine/mono and share/wine/gecko, where Wine looks before it
# offers a download. Hashed 2026-10-21 from dl.winehq.org, which publishes no
# .sha256 files; the .msi files next to these match the hashes in addons.c.
WINE_MONO_VERSION=10.4.1
WINE_MONO_URL=https://dl.winehq.org/wine/wine-mono/10.4.1/wine-mono-10.4.1-x86.tar.xz
WINE_MONO_SHA256=a16606ef0724202e6a6848ece6e0cbba64d11e2f11aefe744af1d93c6d9f99bb
WINE_GECKO_VERSION=2.47.4
WINE_GECKO_X86_URL=https://dl.winehq.org/wine/wine-gecko/2.47.4/wine-gecko-2.47.4-x86.tar.xz
WINE_GECKO_X86_SHA256=2cfc8d5c948602e21eff8a78613e1826f2d033df9672cace87fed56e8310afb6
WINE_GECKO_X86_64_URL=https://dl.winehq.org/wine/wine-gecko/2.47.4/wine-gecko-2.47.4-x86_64.tar.xz
WINE_GECKO_X86_64_SHA256=fd88fc7e537d058d7a8abf0c1ebc90c574892a466de86706a26d254710a82814
# Their license files, from the tagged sources (wine-mono-10.4.1 is commit
# 9265ad14, wine-gecko-2.47.4 is 557ea0c2). The binary tarballs carry none.
WINE_MONO_LICENSE_URL=https://gitlab.winehq.org/mono/wine-mono/-/raw/9265ad1416e250ba394fbc2903275a30e725b29e/COPYING
WINE_MONO_LICENSE_SHA256=0265443ffc97c9450dbcf402c2430bf9fe87d7a6c92d5d7684fcecfe749bf75d
WINE_GECKO_LICENSE_URL=https://gitlab.winehq.org/wine/wine-gecko/-/raw/557ea0c2e9f9ebd621323b3dbfbdd18c2528759c/LICENSE
WINE_GECKO_LICENSE_SHA256=a799adf18bfb1911f16086dc0e2a6d1cd0e31272f47e7ee6841b465b74d249de
WINE_GECKO_LICENSE_HTML_URL=https://gitlab.winehq.org/wine/wine-gecko/-/raw/557ea0c2e9f9ebd621323b3dbfbdd18c2528759c/toolkit/content/license.html
WINE_GECKO_LICENSE_HTML_SHA256=18412e6665fd12c854c85aef601a564bda44363845828b158e7e93e0c2d8f177
