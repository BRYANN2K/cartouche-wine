# Everything the Wine CrossOver build is pinned to. Sourced by the scripts in this
# folder and by .github/workflows/wine-crossover.yml. A new CodeWeavers tarball
# means a new CX_VERSION, its SHA-256 and BUILD_REVISION back to 1.

# CodeWeavers' LGPL sources, https://www.codeweavers.com/crossover/source
# Checked 2026-10-19: 149054023 bytes, Last-Modified 2026-07-21, Wine 11.0 inside.
CX_VERSION=26.3.0
CX_SOURCE_URL=https://media.codeweavers.com/pub/crossover/source/crossover-sources-26.3.0.tar.gz
CX_SOURCE_SHA256=ac99c8ca4b3848f3e81784135f023df266b61c2345726ea55a50b3e030dd6872
CX_SOURCE_SIZE=149054023

# Bumped when the same sources are built again with a changed script or toolchain
BUILD_REVISION=2

# MinGW cross compiler for the PE side, https://github.com/mstorsjo/llvm-mingw
LLVM_MINGW_VERSION=20261006
LLVM_MINGW_URL=https://github.com/mstorsjo/llvm-mingw/releases/download/20261006/llvm-mingw-20261006-ucrt-macos-universal.tar.xz
LLVM_MINGW_SHA256=a7a19b11048e89372637d26279cdb7c430ed3cf8c1e224310421312bf986ebf6

# The x86_64 runner image and its Xcode (actions/runner-images, macOS 15 x64)
XCODE_APP=/Applications/Xcode_16.4.app
MACOSX_DEPLOYMENT_TARGET=15.0

# Homebrew formulas the build links against. Their dylibs are copied into the
# package, so a user's Mac needs none of them.
BREW_BUILD_DEPS="bison flex pkgconf"
# Homebrew sdl2 is sdl2-compat: SDL3 is loaded with dlopen, not an LC_LOAD_DYLIB.
BREW_LINK_DEPS="freetype gnutls molten-vk sdl2 sdl3"
